{
	"schemaVersion": 1,
	"id": "no-enderman-grief",
	"version": "${version}",
	"name": "Enderman Grief Control",
	"description": "Prevents endermen from picking up or placing blocks while leaving all other mob behavior vanilla.",
	"authors": ["Jack Underhill"],
	"contact": {
		"sources": "https://github.com/Jack-Underhill/Enderman-Grief-Control"
	},
	"license": "MIT",
	"icon": "assets/enderman-grief-control/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": ["endermangriefcontrol.fabric.EndermanGriefControlMod"],
		"modmenu": ["endermangriefcontrol.fabric.client.EndermanGriefControlModMenuIntegration"]
	},
	"mixins": ["enderman-grief-control.mixins.json"],
	"depends": {
		"fabricloader": ">=0.15.0",
		"minecraft": "~1.21",
		"java": ">=21",
		"fabric-command-api-v2": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
