<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Coordinates / identity of your plugin artifact -->
    <groupId>endermangriefcontrol</groupId>
    <artifactId>enderman-grief-control-paper</artifactId>
    <version>${revision}</version>
    <name>EndermanGriefControl</name>
    <description>Prevents endermen from picking up or placing blocks while keeping all other mob behavior vanilla.</description>

    <!-- Use Java 21 for compilation -->
    <properties>
        <!-- Release version by default (plain `mvn package`). For a dev build with a
             qualifier, override on the command line: mvn package -Drevision=1.0.0-SNAPSHOT -->
        <revision>1.0.0</revision>
        <minecraft.version>1.21</minecraft.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!-- PaperMC maven repo -->
    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Paper API for Minecraft 1.21.x -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>1.21.11-R0.1-SNAPSHOT</version>
            <!-- 'provided' = available at runtime on the server, not bundled into your plugin jar -->
            <scope>provided</scope>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockbukkit.mockbukkit</groupId>
            <artifactId>mockbukkit-v1.21</artifactId>
            <version>4.108.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.14.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- EndermanGriefControl-mc_<mc version>-paper-<version>[-SNAPSHOT] -->
        <finalName>EndermanGriefControl-mc_${minecraft.version}-paper-${revision}</finalName>
        <resources>
            <!-- Filter plugin.yml (version) and test-mode.properties (bakes in the
                 ENDERMAN_GRIEF_TEST_MODE env var at build time - see TestModeLogger) -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>plugin.yml</include>
                    <include>test-mode.properties</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>plugin.yml</exclude>
                    <exclude>test-mode.properties</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <!-- Use Java 21 "release" flag -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>

            <!-- Mark this plugin as Mojang-mapped so Paper doesn't try to remap it -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <paperweight-mappings-namespace>mojang</paperweight-mappings-namespace>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>

            <!-- Recent Surefire is needed for the JUnit Platform (JUnit 5) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
        </plugins>
    </build>

</project>
